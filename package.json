{
  "name": "calcbot",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test.mjs",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac dir",
    "dist:win": "npm run build && electron-builder --win",
    "build:web": "vite build && node scripts/build-web.mjs"
  },
  "dependencies": {
    "mathjs": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "app.scalar",
    "productName": "Scalar",
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
